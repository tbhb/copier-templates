{%- if include_github_actions and include_docs and include_cloudflare -%}
---
name: Documentation

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout code
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Install uv
        uses: astral-sh/setup-uv@cec208311dfd045dd5311c1add060b2062131d57 # v8.0.0
        with:
          python-version: "{{ python_version }}"
          enable-cache: true

      - name: Install just
        uses: extractions/setup-just@c26183993cea0054160ffaaa55fab2cad53c12fc # v3

      - name: Cache Vale styles
        uses: actions/cache@668228422ae6a00e4ad889ee87cd7109ec5666a7 # v5.0.4
        with:
          path: .vale
          key: {% raw %}vale-styles-${{ hashFiles('.vale.ini', '.vale/config/vocabularies/**') }}{% endraw %}

      - name: Sync Vale styles
        run: vale sync

      - name: Run linters
        run: just lint-docs

      - name: Lint GitHub Actions workflows
        uses: reviewdog/action-actionlint@6fb7acc99f4a1008869fa8a0f09cfca740837d9d # v1.72.0

  build:
    name: "Build"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    needs: lint

    steps:
      - name: Checkout code
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Install uv
        uses: astral-sh/setup-uv@cec208311dfd045dd5311c1add060b2062131d57 # v8.0.0
        with:
          python-version: "{{ python_version }}"
          enable-cache: true

      - name: Install just
        uses: extractions/setup-just@c26183993cea0054160ffaaa55fab2cad53c12fc # v3

      - name: Build
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: just build-docs

      - name: Build PR preview
        if: github.event_name == 'pull_request'
        run: just build-docs-pr {% raw %}${{ github.event.pull_request.number }}{% endraw %}

      - name: Upload artifact
        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7.0.0
        with:
          name: site
          path: site/
          include-hidden-files: true
          retention-days: 1

  deploy-preview:
    name: "Deploy Preview"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    needs: build
    if: github.event_name == 'pull_request'
    environment:
      name: docs-preview
      url: {% raw %}${{ steps.extract-url.outputs.url }}{% endraw %}
    env:
      CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
      CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
      WRANGLER_SEND_METRICS: false
    steps:
      - name: Checkout code
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Download artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: site
          path: site/

      - name: Install uv
        uses: astral-sh/setup-uv@cec208311dfd045dd5311c1add060b2062131d57 # v8.0.0
        with:
          python-version: "{{ python_version }}"

      - name: Install just
        uses: extractions/setup-just@c26183993cea0054160ffaaa55fab2cad53c12fc # v3

      - name: Deploy to Cloudflare Workers (Preview)
        id: deploy
        run: just deploy-docs-pr {% raw %}${{ github.event.pull_request.number }}{% endraw %}

      - name: Extract deployment URL
        id: extract-url
        run: |
          DEPLOY_OUTPUT="{% raw %}${{ steps.deploy.outputs.command-output }}{% endraw %}"
          URL=$(echo "$DEPLOY_OUTPUT" | grep -oE 'https://[^[:space:]]+\.workers\.dev' | head -1)
          echo "url=${URL}" >> "$GITHUB_OUTPUT"

  deploy-production:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    needs: build
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    environment:
      name: docs
      url: https://{{ project_slug }}.tbhb.dev/
    env:
      CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
      CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
      WRANGLER_SEND_METRICS: false
    steps:
      - name: Checkout code
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Download artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: site
          path: site/

      - name: Install uv
        uses: astral-sh/setup-uv@cec208311dfd045dd5311c1add060b2062131d57 # v8.0.0
        with:
          python-version: "{{ python_version }}"

      - name: Install just
        uses: extractions/setup-just@c26183993cea0054160ffaaa55fab2cad53c12fc # v3

      - name: Deploy to Cloudflare Workers
        id: deploy
        run: just deploy-docs
{%- endif %}
