{%- if include_cloudflare -%}
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{ project_slug }}-docs",
  "compatibility_date": "2025-01-12",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },

  // Production routes - deploy to {{ project_slug }}.tbhb.dev
  "routes": [{ "pattern": "{{ project_slug }}.tbhb.dev", "custom_domain": true }],

  // Preview environment for branch-based deployments
  // Deploy with: wrangler deploy --env preview
  // Preview URL: {{ project_slug }}-preview.<subdomain>.workers.dev
  // For branch-specific previews in CI, use --name flag:
  // wrangler deploy --env preview --name {{ project_slug }}-preview-${BRANCH_NAME}
  "env": {
    "preview": {
      "name": "{{ project_slug }}-preview",
      "routes": []
    }
  }
}
{%- endif %}
