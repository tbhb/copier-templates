{%- if include_github_actions -%}
---
name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout code
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Install uv
        uses: astral-sh/setup-uv@cec208311dfd045dd5311c1add060b2062131d57 # v8.0.0
        with:
          python-version: "3.13"
          enable-cache: true

      - name: Install Node.js
        uses: actions/setup-node@53b83947a5a98c8d113130e565377fae1a50d02f # v6.3.0
        with:
          node-version: "22"

      - name: Install Biome
        uses: biomejs/setup-biome@4c91541eaada48f67d7dbd7833600ce162b68f51 # v2.7.1
        with:
          version: latest

      - name: Install just
        uses: extractions/setup-just@c26183993cea0054160ffaaa55fab2cad53c12fc # v3

      - name: Install linting tools
        run: |
          npm install -g cspell
          uv tool install vale
          uv tool install yamllint
          uv tool install rumdl

      - name: Install dependencies
        run: just install

      - name: Cache Vale styles
        uses: actions/cache@668228422ae6a00e4ad889ee87cd7109ec5666a7 # v5.0.4
        with:
          path: .vale
          key: {% raw %}vale-styles-${{ hashFiles('.vale.ini', '.vale/config/vocabularies/**') }}{% endraw %}

      - name: Sync Vale styles
        run: vale sync

      - name: Run linters
        run: just lint

      - name: Lint GitHub Actions workflows
        uses: reviewdog/action-actionlint@6fb7acc99f4a1008869fa8a0f09cfca740837d9d # v1.72.0

  test:
    name: "Test ({% raw %}${{ matrix.os }}{% endraw %}, Python {% raw %}${{ matrix.python-version }}{% endraw %})"
    needs: lint
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
        python-version: ["3.10", "3.11", "3.12", "3.13", "3.14", "3.14t"]

    steps:
      - name: Checkout code
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - name: Install uv
        uses: astral-sh/setup-uv@cec208311dfd045dd5311c1add060b2062131d57 # v8.0.0
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
          enable-cache: true

      - name: Install just
        uses: extractions/setup-just@c26183993cea0054160ffaaa55fab2cad53c12fc # v3

      - name: Install dependencies
        run: just install

      - name: Run tests
        run: just test-coverage

      - name: Upload coverage to Codecov
        if: matrix.os == 'ubuntu-latest' && matrix.python-version == '3.10' && github.actor != 'dependabot[bot]'
        uses: codecov/codecov-action@57e3a136b779b570ffcdbf80b3bdc90e7fab3de2 # v6.0.0
        env:
          CODECOV_TOKEN: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
        with:
          files: ./coverage.xml
          fail_ci_if_error: false
{%- endif %}
