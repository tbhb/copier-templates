{% raw %}set unstable := true
set positional-arguments := true

# Default recipe
default: check

# --- Setup ---

# Set up development environment
setup: prek-install vale-sync

# --- Format ---

# Format code
format: format-config format-docs

# Format configuration files
format-config *args:
    biome format --write {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Format documentation
format-docs *args:
    just format-markdown {% endraw %}{{ "{% raw %}" }}{% raw %}{{ args }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Format Markdown files
format-markdown *args:
    rumdl fmt {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# --- Fix ---

# Fix code issues
fix: fix-config fix-docs

# Fix configuration files
fix-config *args:
    biome check --write {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Fix documentation
fix-docs *args:
    just fix-markdown {% endraw %}{{ "{% raw %}" }}{% raw %}{{ args }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Fix Markdown files
fix-markdown *args:
    rumdl check --fix {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# --- Lint ---

# Run all linters
lint: lint-docs lint-config lint-spelling

# Lint configuration files
lint-config: lint-json lint-yaml

# Lint documentation
lint-docs *args:
    just lint-markdown {% endraw %}{{ "{% raw %}" }}{% raw %}{{ args }}{% endraw %}{{ "{% endraw %}" }}{% raw %}
    just lint-prose {% endraw %}{{ "{% raw %}" }}{% raw %}{{ args }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Lint JSON files
lint-json *args:
    biome check --files-ignore-unknown=true {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Lint Markdown files
lint-markdown *args:
    rumdl check {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Lint prose in Markdown files
lint-prose *args:
    vale {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "README.md" } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Check spelling
lint-spelling *args:
    cspell {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# Lint YAML files
lint-yaml *args:
    yamllint --strict {% endraw %}{{ "{% raw %}" }}{% raw %}{{ if args == "" { "." } else { args } }}{% endraw %}{{ "{% endraw %}" }}{% raw %}

# --- Quality gates ---

# Check that everything is ready for commit
check: format fix lint

# --- Utilities ---

# Install dependencies
install:
    vale sync

# Run pre-commit hooks on changed files
prek:
    prek

# Run pre-commit hooks on all files
prek-all:
    prek run --all-files

# Install pre-commit hooks
prek-install:
    prek install -t commit-msg -t pre-commit

# Sync Vale styles and dictionaries
vale-sync:
    vale sync
{% endraw %}
