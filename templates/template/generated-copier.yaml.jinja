# Copier configuration for {{ template_slug }} template
# https://copier.readthedocs.io/
---
_min_copier_version: "9.0.0"

_subdirectory: .

_exclude:
  - copier.yaml
  - "*.pyc"
  - __pycache__
  - .git

_jinja_extensions:
  - jinja2.ext.do
  - jinja2.ext.loopcontrols

# Template questions
project_name:
  type: str
  help: Human-readable project name

project_slug:
  type: str
  help: Repo/project name (hyphenated)
{% raw %}
  default: "{{ project_name | lower | replace(' ', '-') | replace('_', '-') }}"
{% endraw %}

project_description:
  type: str
  help: One-line project description

_tasks:
  - "git init"
{% raw %}
  - "mkdir -p .vale/config/vocabularies/{{ project_slug }}"
  - "touch .vale/config/vocabularies/{{ project_slug }}/accept.txt"
  - "touch .vale/config/vocabularies/{{ project_slug }}/reject.txt"
{% endraw %}
  - "vale sync"
  - "prek install -t commit-msg -t pre-commit"
  - "git add ."
